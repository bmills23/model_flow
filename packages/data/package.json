{
  "name": "@model-flow/data",
  "version": "0.0.0",
  "private": true,
  "description": "Build scripts: attribution and licence documents, chemical and toxicity database builds.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "build": "echo 'nothing to build'",
    "generate": "tsx scripts/generate-docs.ts",
    "build:rsl": "tsx scripts/build-rsl.ts",
    "build:vapor": "tsx scripts/build-vapor.ts",
    "fetch:rsl": "tsx scripts/fetch-rsl.ts",
    "build:nrwqc": "tsx scripts/build-nrwqc.ts",
    "fetch:nrwqc": "tsx scripts/fetch-nrwqc.ts",
    "build:sediment": "tsx scripts/build-sediment.ts",
    "extract:r4-sediment": "tsx scripts/extract-r4-sediment.ts"
  },
  "dependencies": {
    "@model-flow/engine": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "26.6.5",
    "read-excel-file": "9.3.12",
    "tsx": "4.23.15",
    "vitest": "5.0.5"
  },
  "exports": {
    "./rsl-types": "./src/rsl/types.ts",
    "./nrwqc-types": "./src/nrwqc/types.ts",
    "./sediment-types": "./src/sediment/types.ts",
    "./generated/*": "./generated/*"
  }
}
